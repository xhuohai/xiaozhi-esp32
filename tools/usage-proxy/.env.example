# ESP32 访问 proxy 时使用的设备令牌。不要使用 Cursor / Codex 登录凭据。
DEVICE_TOKEN=replace-with-device-token

# Cursor 网页/IDE 会话 Cookie 值（WorkosCursorSessionToken= 后面的部分）。
# 自己从浏览器或 IDE 取出后填这里即可。
CURSOR_SESSION_TOKEN=

# GPT / Codex。服务器部署时直接填这两个，不必拷贝 ~/.codex/auth.json。
# access_token 来自 Codex 登录后的 tokens.access_token。
# ChatGPT-Account-Id 来自 tokens.account_id。
CODEX_ACCESS_TOKEN=
CHATGPT_ACCOUNT_ID=

# 本机开发可选：不填上面两个时，每次刷新会重读这个文件。
CODEX_AUTH_FILE=~/.codex/auth.json
